<?xml version="1.0" ?>
<!-- Gazebo Sim model. Keep sensor and drive plugins here (not in the URDF). -->
<sdf version="1.9"><model name="argus_robot">
  <self_collide>false</self_collide>
  <!-- The chassis bottom is above the ground.  The wheel contacts, rather
       than the body collision, support the robot in the physics world. -->
  <!-- Gazebo uses stable primitive visuals because the supplied STL contains
       no UV/tangent data, which crashes/stalls Ogre2 rendering.  RViz keeps
       using the supplied STL through the URDF. -->
  <link name="base_link"><pose>0 0 0.245 0 0 0</pose><inertial><mass>12</mass><inertia><ixx>0.32</ixx><iyy>0.45</iyy><izz>0.60</izz></inertia></inertial><collision name="body_collision"><geometry><box><size>0.62 0.46 0.28</size></box></geometry></collision><visual name="chassis"><geometry><box><size>0.62 0.46 0.28</size></box></geometry><material><ambient>0.95 0.68 0.08 1</ambient><diffuse>0.95 0.68 0.08 1</diffuse></material></visual>
    <!-- CPU ray sensor avoids the GPU texture-memory stall caused by the
         Gazebo LiDAR visual.  RViz still renders the bridged /scan rays. -->
    <sensor name="lidar" type="ray"><pose>0.18 0 0.20 0 0 0</pose><topic>/scan</topic><always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>12</max><resolution>0.01</resolution></range></ray></sensor>
    <!-- Keep the RGB feed lightweight enough for an integrated-GPU laptop.
         It remains suitable for a safety/object-detection node. -->
    <sensor name="camera" type="camera"><pose>0.30 0 0.14 0 0 0</pose><topic>/camera/image</topic><always_on>true</always_on><update_rate>5</update_rate><camera><horizontal_fov>1.05</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>12</far></clip></camera></sensor>
  </link>
  <link name="left_wheel_link"><pose>0 0.255 0.105 1.5708 0 0</pose><inertial><mass>0.7</mass><inertia><ixx>0.004</ixx><iyy>0.002</iyy><izz>0.004</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.105</radius><length>0.055</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.105</radius><length>0.055</length></cylinder></geometry></visual></link>
  <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
  <link name="right_wheel_link"><pose>0 -0.255 0.105 1.5708 0 0</pose><inertial><mass>0.7</mass><inertia><ixx>0.004</ixx><iyy>0.002</iyy><izz>0.004</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.105</radius><length>0.055</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.105</radius><length>0.055</length></cylinder></geometry></visual></link>
  <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.51</wheel_separation><wheel_radius>0.105</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><odom_publish_frequency>30</odom_publish_frequency><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id></plugin>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
</model></sdf>
