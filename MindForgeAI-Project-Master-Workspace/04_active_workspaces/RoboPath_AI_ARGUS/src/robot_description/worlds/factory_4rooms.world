<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="factory_premium_grand">
    
    <!-- Environment & Lighting -->
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.9 0.95 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Polished Concrete Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.45 0.47 0.5 1</ambient>
            <diffuse>0.5 0.52 0.55 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- GRAND BACK WALL & WINDOW ARCHITECTURE (With New Black Extensions) -->
    <!-- ================================================================= -->
    <model name="back_grand_wall">
      <static>true</static>
      <link name="link">
